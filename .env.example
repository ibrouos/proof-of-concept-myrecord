# Server
PORT=3000
NODE_ENV=development

# App
APP_NAME=Student Portal

# Required for CAS auth — prepended to relative redirects so CAS can validate the service URL.
# Leave blank if not using CAS.
BASE_URL=

# Session — use a long random string (e.g. openssl rand -hex 32)
SESSION_NAME=app.sid
SESSION_SECRET=replace-with-a-long-random-secret

# CSRF — can share SESSION_SECRET or use a separate value
CSRF_SECRET=replace-with-another-long-random-secret

# Auth provider: none | cas
AUTH_PROVIDER=none

# CAS — only required when AUTH_PROVIDER=cas
# CAS_HOST=cas-qa1.shef.ac.uk
# CAS_HOST=cas-qa2.shef.ac.uk
# CAS_PORT=8443

# Logging
LOG_LEVEL=debug
