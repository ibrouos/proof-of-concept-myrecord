<% layout("../layout") %>
<%~ include("../partials/myrecord-tabs", it) %>

<h1>Personal details</h1>

<p class="guidance">
  <strong>Amendments/Corrections</strong> to previous qualifications should be made by printing this page,
  and taking it to the Applicant Information Desk.
</p>
<p class="guidance">
  In the majority of cases, for name changes to be made you will need to bring an official form of ID
  with you e.g. Birth Certificate, Passport, Marriage Certificate, EU national identity card, adoption
  certificate or Deed Poll.
</p>

<dl class="detail-list">
  <div class="detail-list__row">
    <dt class="detail-list__label">Registration Number</dt>
    <dd class="detail-list__value"><%= it.student.registrationNumber %></dd>
  </div>
  <div class="detail-list__row">
    <dt class="detail-list__label">Student Support Number</dt>
    <dd class="detail-list__value"><%= it.student.studentSupportNumber || '—' %></dd>
  </div>
  <div class="detail-list__row">
    <dt class="detail-list__label">HUSID</dt>
    <dd class="detail-list__value detail-list__value--mono"><%= it.student.husid %></dd>
  </div>
  <div class="detail-list__row">
    <dt class="detail-list__label">Name</dt>
    <dd class="detail-list__value"><%= it.student.name %></dd>
  </div>
  <div class="detail-list__row">
    <dt class="detail-list__label">Date of Birth</dt>
    <dd class="detail-list__value"><%= it.student.dateOfBirth %></dd>
  </div>
  <div class="detail-list__row">
    <dt class="detail-list__label">Home/Overseas</dt>
    <dd class="detail-list__value"><%= it.student.homeOverseas %></dd>
  </div>
  <div class="detail-list__row">
    <dt class="detail-list__label">Ethnic Origin</dt>
    <dd class="detail-list__value"><%= it.student.ethnicOrigin %></dd>
  </div>
</dl>

<h2>Next of Kin</h2>

<% if (it.student.nextOfKin && it.student.nextOfKin.length) { %>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Relationship</th>
    </tr>
  </thead>
  <tbody>
    <% it.student.nextOfKin.forEach(function(kin) { %>
    <tr>
      <td><%= kin.name %></td>
      <td><%= kin.relationship %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } else { %>
<p class="empty-state">No next of kin recorded.</p>
<% } %>
