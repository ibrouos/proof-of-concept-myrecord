<% layout("../layout") %>
<%~ include("../partials/myrecord-tabs", it) %>

<h1>Define a correspondence or future address</h1>

<form method="POST" action="/myrecord/future-address" class="address-form">
  <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />

  <label>Address Type :<span class="req">* (required)</span>
  <select name="addressType" required>
    <option value="">Please select…</option>
    <option value="correspondence">Correspondence</option>
    <option value="future">Future</option>
  </select></label>

  <label>Start Date :<span class="req">* (required)</span>
  <input name="startDate" type="date" required></label>

  <label>End Date :
  <input name="endDate" type="date"></label>

  <%~ include("../partials/address-fields", it) %>
  <button type="submit">Save address</button>
</form>
