<%
  const a = it.address || {};
  const countries = it.countries || [];
  const residentialTypes = [
    "Not resident",
    "University accommodation",
    "Private rented",
    "Owner occupied",
    "Living with parent/guardian",
    "Other",
  ];
%>
<label>Residential Type:<span class="req">* (required)</span>
<select name="residentialType" required>
  <option value="">Please select…</option>
  <% residentialTypes.forEach(function (type) { %>
  <option value="<%= type %>" <%= a.residentialType === type ? "selected" : "" %>><%= type %></option>
  <% }) %>
</select></label>

<label>Address Line 1:<span class="req">* (required)</span>
<input name="addressLine1" type="text" required autocomplete="address-line1" value="<%= a.addressLine1 || "" %>"></label>

<label>Address Line 2:
<input name="addressLine2" type="text" autocomplete="address-line2" value="<%= a.addressLine2 || "" %>"></label>

<label>Address Line 3:
<input name="addressLine3" type="text" autocomplete="address-line3" value="<%= a.addressLine3 || "" %>"></label>

<label>Town:<span class="req">* (required)</span>
<input name="town" type="text" required autocomplete="address-level2" value="<%= a.town || "" %>"></label>

<label>Region/County:
<input name="regionCounty" type="text" autocomplete="address-level1" value="<%= a.regionCounty || "" %>"></label>

<label>Country:<span class="req">* (required)</span>
<select name="country" id="address-country" required autocomplete="country-name">
  <% countries.forEach(function (c) { %>
  <option value="<%= c %>" <%= (a.country || "UNITED KINGDOM") === c ? "selected" : "" %>><%= c %></option>
  <% }) %>
</select></label>

<div class="field-group">
  <span class="field-group__label">UK Post Code:</span>
  <div class="field-group__inputs">
    <label class="sr-only" for="postcode-outward">Outward code</label>
    <input id="postcode-outward" name="postcodeOutward" type="text" class="input--postcode input--postcode-outward" placeholder="S40" maxlength="4" autocomplete="postal-code" spellcheck="false" value="<%= a.postcodeOutward || "" %>">
    <label class="sr-only" for="postcode-inward">Inward code</label>
    <input id="postcode-inward" name="postcodeInward" type="text" class="input--postcode input--postcode-inward" placeholder="7FG" maxlength="3" autocomplete="off" spellcheck="false" value="<%= a.postcodeInward || "" %>">
  </div>
  <p class="form-hint">Required for UK addresses.</p>
</div>

<label>Telephone:
<input name="telephone" type="tel" autocomplete="tel" value="<%= a.telephone || "" %>"></label>

<label>Mobile Phone:
<input name="mobilePhone" type="tel" autocomplete="tel-national" value="<%= a.mobilePhone || "" %>"></label>

<label>Email:
<input name="email" type="email" autocomplete="email" spellcheck="false" value="<%= a.email || "" %>"></label>
